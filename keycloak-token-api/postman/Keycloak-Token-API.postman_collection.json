{
  "info": {
    "_postman_id": "keycloak-token-api-collection-v1",
    "name": "Keycloak Token API",
    "description": "Postman collection for keycloak-token-api MuleSoft application.\n\nCovers:\n- POST /gettoken  (positive + negative scenarios)\n- POST /validatetoken (positive + negative scenarios)\n\nBase URL: http://localhost:8081\nKeycloak: http://localhost:8080/realms/Muletest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mule_base_url",
      "value": "http://localhost:8081",
      "type": "string",
      "description": "MuleSoft application base URL"
    },
    {
      "key": "keycloak_base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Keycloak server base URL"
    },
    {
      "key": "keycloak_realm",
      "value": "Muletest",
      "type": "string",
      "description": "Keycloak realm name"
    },
    {
      "key": "keycloak_client_id",
      "value": "Salesforce-dev",
      "type": "string",
      "description": "Keycloak client ID"
    },
    {
      "key": "keycloak_client_secret",
      "value": "HvgPTaUVCqlrLBJKczi5IsuTQLfSL5fb",
      "type": "string",
      "description": "Keycloak client secret"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "Captured access token from /gettoken response"
    }
  ],
  "item": [
    {
      "name": "01 - Direct Keycloak Tests",
      "description": "Direct calls to Keycloak to verify connectivity before testing via MuleSoft",
      "item": [
        {
          "name": "01.1 - Direct: Get Token from Keycloak",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has access_token', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('Token captured:', json.access_token.substring(0, 50) + '...');",
                  "});",
                  "pm.test('Token type is Bearer', function() {",
                  "    pm.expect(pm.response.json().token_type).to.eql('Bearer');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{keycloak_client_id}}" },
                { "key": "password", "value": "{{keycloak_client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{keycloak_base_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_base_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"]
            }
          }
        },
        {
          "name": "01.2 - Direct: Introspect Token from Keycloak",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token is active', function() {",
                  "    pm.expect(pm.response.json().active).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "token", "value": "{{access_token}}" }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{keycloak_client_id}}" },
                { "key": "password", "value": "{{keycloak_client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{keycloak_base_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token/introspect",
              "host": ["{{keycloak_base_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token", "introspect"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - POST /gettoken",
      "description": "Tests for MuleSoft POST /gettoken endpoint",
      "item": [
        {
          "name": "02.1 - POSITIVE: Get Token - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has access_token', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('Token captured from MuleSoft:', json.access_token.substring(0, 50) + '...');",
                  "});",
                  "pm.test('Response has token_type Bearer', function() {",
                  "    pm.expect(pm.response.json().token_type).to.eql('Bearer');",
                  "});",
                  "pm.test('Response has expires_in', function() {",
                  "    pm.expect(pm.response.json().expires_in).to.be.a('number').and.above(0);",
                  "});",
                  "pm.test('Content-Type is application/json', function() {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{mule_base_url}}/gettoken",
              "host": ["{{mule_base_url}}"],
              "path": ["gettoken"]
            }
          }
        },
        {
          "name": "02.2 - NEGATIVE: Get Token - Wrong HTTP Method (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 405 Method Not Allowed', function() {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mule_base_url}}/gettoken",
              "host": ["{{mule_base_url}}"],
              "path": ["gettoken"]
            }
          }
        },
        {
          "name": "02.3 - NEGATIVE: Get Token - Invalid Endpoint Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', function() {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{mule_base_url}}/gettoken/invalid",
              "host": ["{{mule_base_url}}"],
              "path": ["gettoken", "invalid"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - POST /validatetoken",
      "description": "Tests for MuleSoft POST /validatetoken endpoint",
      "item": [
        {
          "name": "03.1 - POSITIVE: Validate Token - Active Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure access_token is set from previous test",
                  "var token = pm.collectionVariables.get('access_token');",
                  "if (!token || token === '') {",
                  "    console.warn('WARNING: access_token is empty. Run 02.1 first to capture token.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token is active', function() {",
                  "    pm.expect(pm.response.json().active).to.eql(true);",
                  "});",
                  "pm.test('Response has expected fields', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('exp');",
                  "    pm.expect(json).to.have.property('iss');",
                  "    pm.expect(json).to.have.property('sub');",
                  "    pm.expect(json).to.have.property('client_id');",
                  "});",
                  "pm.test('Content-Type is application/json', function() {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"access_token\": \"{{access_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        },
        {
          "name": "03.2 - NEGATIVE: Validate Token - Missing access_token field",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error is INVALID_REQUEST', function() {",
                  "    pm.expect(pm.response.json().error).to.eql('INVALID_REQUEST');",
                  "});",
                  "pm.test('Error description is present', function() {",
                  "    pm.expect(pm.response.json()).to.have.property('description');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        },
        {
          "name": "03.3 - NEGATIVE: Validate Token - Empty access_token value",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error is INVALID_REQUEST', function() {",
                  "    pm.expect(pm.response.json().error).to.eql('INVALID_REQUEST');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"access_token\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        },
        {
          "name": "03.4 - NEGATIVE: Validate Token - Expired or Invalid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (RFC 7662)', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token is inactive (active: false)', function() {",
                  "    pm.expect(pm.response.json().active).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"access_token\": \"eyJhbGciOiJSUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJFWFBJUUVEX0lOVkFMSURfVE9LRU4ifQ.INVALID.SIGNATURE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        },
        {
          "name": "03.5 - NEGATIVE: Validate Token - Wrong HTTP Method (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 405 Method Not Allowed', function() {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        },
        {
          "name": "03.6 - NEGATIVE: Validate Token - Malformed JSON Body",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 or 500', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ not valid json }",
              "options": { "raw": { "language": "text" } }
            },
            "url": {
              "raw": "{{mule_base_url}}/validatetoken",
              "host": ["{{mule_base_url}}"],
              "path": ["validatetoken"]
            }
          }
        }
      ]
    }
  ]
}